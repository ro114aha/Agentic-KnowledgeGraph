{
  "name": "Agentic Knowledge Graph (.NET 8 + Neo4j)",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "forwardPorts": ["neo4j:7474", "neo4j:7687"],
  "portsAttributes": {
    "neo4j:7474": { "label": "Neo4j Browser" },
    "neo4j:7687": { "label": "Neo4j Bolt" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-dotnettools.csdevkit"]
    }
  },
  "postCreateCommand": "dotnet restore src/KgDemo"
}
